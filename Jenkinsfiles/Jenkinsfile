pipeline {
    agent any
    options {
        buildDiscarder(logRotator(numToKeepStr: '2'))
    }
    environment {
        AWS_ACCOUNT_ID = "640003498020"
        AWS_REGION = "eu-central-1"
        IMAGE_REPO_NAME = "partners-new"
        IMAGE_TAG = "latest"
        CLUSTER_NAME = "fkuatecs1"
        SERVICE_NAME = "partners-new-staging"
        REPOSITORY_URI = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${IMAGE_REPO_NAME}"
        SONAR_SCANNER_HOME = tool 'SonarScanner'
        // GitHub
        GITHUB_USER = credentials('GITHUB_USER')
        GITHUB_TOKEN = credentials('GithubToken')
        GITHUB_REPOSITORY = "SquaredFinancial-Development-Team/partners-new"
    }
    stages {
        stage('Notification to Slack') {
            steps {
                slackSend channel: 'jenkins-updates', message: 'Started jenkins task "partners-new-staging" ', tokenCredentialId: 'sqfindevops'
            }
        }
        stage('Logging into AWS ECR') {
            steps {
                script {
                    sh "aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
                    sh "echo ${GITHUB_TOKEN} > token.txt"
                }
            }
        }
        stage('Cloning Git') {
            steps {
                checkout([$class: 'GitSCM', branches: [[name: '*/staging']], doGenerateSubmoduleConfigurations: false, extensions: [], submoduleCfg: [], userRemoteConfigs: [[credentialsId: '', url: "https://${GITHUB_USER}:${GITHUB_TOKEN}@github.com/${GITHUB_REPOSITORY}"]]])
            }
        }
        stage('Building image') {
            steps {
                sh 'docker build  --pull --rm --no-cache --build-arg SSH_PRIVATE_KEY="$(cat ~jenkins/.ssh/id_ed25519)" --build-arg GITHUB_TOKEN="${GITHUB_TOKEN}" -f "Dockerfiles/Dockerfile" -t "${IMAGE_REPO_NAME}:${IMAGE_TAG}" .'
            }
        }
        stage('Pushing to ECR') {
            steps {
                script {
                    sh "docker tag ${IMAGE_REPO_NAME}:${IMAGE_TAG} ${REPOSITORY_URI}:$IMAGE_TAG"
                    sh "docker push ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${IMAGE_REPO_NAME}:${IMAGE_TAG}"
                }
            }
        }
        stage('Restart ECS Service') {
            steps {
                script {
                    sh  "aws ecs update-service --cluster ${CLUSTER_NAME} --service ${SERVICE_NAME}   --force-new-deployment --region ${AWS_REGION}"
                }
            }
        }
        stage('Wait for ECS Service Update') {
            steps {
                script {
                    def checkServiceStatus = { ->
                        def result = sh(script: """
                        aws ecs describe-services --cluster ${CLUSTER_NAME} --services ${SERVICE_NAME} --region ${AWS_REGION} --query 'services[0].deployments' --output json
                        """, returnStdout: true).trim()
                        def jsonSlurper = new groovy.json.JsonSlurper()
                        def deployments = jsonSlurper.parseText(result)
                        return deployments.collect { it as HashMap }
                    }
                    timeout(time: 30, unit: 'MINUTES') {
                        waitUntil {
                            def deployments = checkServiceStatus()
                            def deploymentCount = deployments.size()
                            if (deploymentCount == 1) {
                                def status = deployments[0].status
                                def desiredTasks = deployments[0].desiredCount
                                def runningTasks = deployments[0].runningCount
                                if (status == 'PRIMARY' && desiredTasks == runningTasks) {
                                    echo 'Service update completed successfully.'
                                    return true
                                }
                            }
                            echo 'Waiting for service update to complete...'
                            sleep(time: 30, unit: 'SECONDS')
                            return false
                        }
                    }
                }
            }
        }
        stage('Finish job jotification') {
            steps {
                slackSend channel: 'jenkins-updates', message: 'Jenkins task "partners-new-staging" completed successfully', tokenCredentialId: 'sqfindevops'
            }
        }
    }
}
